{
  "name": "vetoboard-mcp",
  "version": "1.0.0",
  "description": "Dynamic Shared Whiteboard, ELECTRE/QMV Mathematical Governance, Non-Compensatory Hard Veto & Zero-Hallucination Math Auditing MCP Server for Claude Code, Cursor, Antigravity, and Codex (EN/ZH).",
  "license": "Apache-2.0",
  "type": "module",
  "bin": {
    "vetoboard-mcp": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "packs",
    "README.md",
    "README.zh-CN.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "start": "node ./dist/cli.js",
    "serve": "node ./dist/cli.js serve"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "vetoboard",
    "multi-agent",
    "electre",
    "governance",
    "decision-making",
    "unit-economics",
    "claude-code",
    "cursor",
    "codex",
    "antigravity"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.0.0",
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0",
    "vitest": "^4.1.5"
  }
}
