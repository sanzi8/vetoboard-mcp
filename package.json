{
  "name": "vetoboard-mcp",
  "version": "1.4.1",
  "description": "Dynamic Shared Whiteboard, ELECTRE/QMV Mathematical Governance, 16 Specialist Roles, 27 Governance Skills & Deterministic Math Auditing MCP Server for Claude Code, Cursor, Antigravity, Codex, Hermes & T3 Code.",
  "author": "sanzi8",
  "license": "Apache-2.0",
  "homepage": "https://github.com/sanzi8/vetoboard-mcp#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sanzi8/vetoboard-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/sanzi8/vetoboard-mcp/issues"
  },
  "type": "module",
  "bin": {
    "vetoboard-mcp": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "packs",
    "skills",
    "assets",
    "README.md",
    "README.en.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:compat": "vitest run test/cross-platform-compat.test.ts",
    "smoke:llm": "node ./scripts/smoke-llm-compat.mjs",
    "start": "node ./dist/cli.js",
    "serve": "node ./dist/cli.js serve"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "vetoboard",
    "multi-agent",
    "electre",
    "governance",
    "decision-making",
    "unit-economics",
    "claude-code",
    "cursor",
    "codex",
    "antigravity"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.0.0",
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0",
    "vitest": "^4.1.5"
  }
}
